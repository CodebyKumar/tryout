# Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# Models per role. Each is a comma-separated fallback chain (used on rate limit / error).
MODEL_TURN=openai/gpt-oss-20b,qwen/qwen3.8-27b
MODEL_STRONG=openai/gpt-oss-120b,openai/gpt-oss-20b
MODEL_AUX=qwen/qwen3.8-27b,openai/gpt-oss-20b

# Default interview time budget in seconds
TIME_BUDGET_SEC=480

# Interview rules (optional; these are the defaults)
# MAX_PROBES_PER_SLOT=2
# MAX_PROBES_PER_SECTION=3
# WRAPUP_RESERVE_SEC=45

# Upload caps in MB (optional)
# MAX_DOC_MB=5
# MAX_AUDIO_MB=10

# Voice: Piper voice model (.onnx with its .onnx.json next to it) and Groq Whisper model
PIPER_MODEL=
STT_MODEL=whisper-large-v3

# Cloud Postgres (Neon or Supabase). Use a separate dev database or branch, never production.
# Format: postgresql+asyncpg://user:password@host/dbname
DATABASE_URL=

# Object storage for original JDs and resumes (S3-compatible, e.g. Supabase Storage or Cloudflare R2)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
