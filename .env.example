# Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# Models per role. Each is a comma-separated fallback chain (used on rate limit / error).
MODEL_TURN=openai/gpt-oss-20b,qwen/qwen3.8-27b
MODEL_STRONG=openai/gpt-oss-120b,openai/gpt-oss-20b
MODEL_AUX=qwen/qwen3.8-27b,openai/gpt-oss-20b

# Default interview time budget in seconds
TIME_BUDGET_SEC=480

# Interview rules (optional; these are the defaults)
# MAX_PROBES_PER_SLOT=2
# MAX_PROBES_PER_SECTION=3
# WRAPUP_RESERVE_SEC=45

# Upload caps in MB (optional)
# MAX_DOC_MB=5
# MAX_AUDIO_MB=10

# Voice: Groq Whisper for speech to text; Deepgram Aura for the interviewer's voice (https://console.deepgram.com,
# free credit). Without DEEPGRAM_API_KEY the room uses the browser's own speech.
STT_MODEL=whisper-large-v3
DEEPGRAM_API_KEY=
DEEPGRAM_VOICE=aura-2-thalia-en

# Accounts: the account that signs up with ADMIN_EMAIL becomes the admin. Others wait for the admin's approval.
ADMIN_EMAIL=
# SESSION_DAYS=14        how long a login lasts
# LINK_DAYS=14           how long a candidate link works when no interview window is set

# Capacity (optional; these are the defaults)
# MAX_LIVE_INTERVIEWS=4  interviews running at once; the free Groq tier is the limit
# IDLE_MINUTES=10        an interview with no answer for this long is ended and evaluated

# Cloud Postgres (Neon or Supabase). Use a separate dev database or branch, never production.
# Format: postgresql+asyncpg://user:password@host/dbname
DATABASE_URL=

# Original uploaded files go to Supabase Storage (free tier). Optional: without a key only the text is kept.
# Project URL, and a secret key from Project Settings > API Keys (never the publishable key in a browser).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
STORAGE_BUCKET=documents
