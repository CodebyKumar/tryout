# Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# Models per role. Each is a comma-separated fallback chain (used on rate limit / error).
MODEL_TURN=openai/gpt-oss-20b,qwen/qwen3.8-27b
MODEL_STRONG=openai/gpt-oss-120b,openai/gpt-oss-20b
MODEL_AUX=qwen/qwen3.8-27b,openai/gpt-oss-20b

# Default interview time budget in seconds
TIME_BUDGET_SEC=480

# Voice: Piper voice model (.onnx with its .onnx.json next to it) and Groq Whisper model
PIPER_MODEL=
STT_MODEL=whisper-large-v3
